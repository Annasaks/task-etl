# --- API keys (required) ---
# Get your free API-Sports key at https://www.api-football.com (yes, same provider)
API_SPORTS_KEY=
# Get your free API-Football key at https://apifootball.com
API_FOOTBALL_KEY=

# --- Pipeline scope ---
LEAGUE_ID_API_SPORTS=39          # 39 = Premier League on API-Sports
LEAGUE_ID_API_FOOTBALL=152       # 152 = Premier League on API-Football
SEASON=2023                      # 2023 = 2023/24 season

# --- Load backend: "sqlite" (default, local file) or "bigquery" (cloud) ---
LOAD_BACKEND=sqlite

# --- BigQuery config (only used when LOAD_BACKEND=bigquery) ---
BIGQUERY_PROJECT=
BIGQUERY_DATASET_API_SPORTS=
BIGQUERY_DATASET_API_FOOTBALL=
BIGQUERY_LOCATION=US
